{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/login.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/payment-result", "destination": "/payment-result.html" },
    { "source": "/api/paytr/callback", "destination": "/api/wallet?action=paytr_callback" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/auth/anonymous", "destination": "/api/auth-anonymous" },
    { "source": "/v1/users/:userId/wallet", "destination": "/api/wallet?userId=:userId" },
    { "source": "/v1/users/:userId/wallet/ledger", "destination": "/api/wallet?action=ledger&userId=:userId" },
    { "source": "/v1/users/:userId/purchases", "destination": "/api/wallet?action=purchases&userId=:userId" },
    { "source": "/v1/store/products", "destination": "/api/wallet?action=products" },
    { "source": "/v1/purchases/verify", "destination": "/api/wallet?action=verify_purchase" },
    { "source": "/v1/quote", "destination": "/api/wallet?action=quote" },
    { "source": "/v1/generations", "destination": "/api/generations" },
    { "source": "/v1/generations/:id", "destination": "/api/generation-status?id=:id" },
    { "source": "/v1/users/:userId/generations", "destination": "/api/user-generations?userId=:userId" }
  ]
}
