PORT=8080
NODE_ENV=development
VEYRA_ADMIN_TOKEN=change-me
VEYRA_SESSION_SECRET=change-me-to-a-random-32-plus-character-secret
DATABASE_URL=
REDIS_URL=

# Public legal/support URLs
VEYRA_PRIVACY_URL=
VEYRA_TERMS_URL=
VEYRA_SUPPORT_URL=
VEYRA_ACCOUNT_DELETION_URL=

# Android / Google Play
GOOGLE_PLAY_PACKAGE=ai.veyra.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_REQUIRED=false

# Apple / App Store
APPLE_BUNDLE_ID=ai.veyra.app
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# AI providers
AI_PROVIDER_PRIMARY=runway
AI_PROVIDER_FALLBACK=mock
# Keep this secret server-side. Do not expose it to browser/mobile clients.
RUNWAYML_API_SECRET=
# Legacy alias also supported by the backend:
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
HF_TOKEN=
HF_INFERENCE_PROVIDER=auto
REPLICATE_API_TOKEN=

# Storage / analytics placeholders
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SENTRY_DSN=
