PORT=8080
NODE_ENV=development
VEYRA_ADMIN_TOKEN=change-me
VEYRA_SESSION_SECRET=change-me-to-a-random-32-plus-character-secret
DATABASE_URL=
REDIS_URL=
VEYRA_PUBLIC_BASE_URL=https://veyra-ai-sigma.vercel.app

# Public legal/support URLs
VEYRA_PRIVACY_URL=
VEYRA_TERMS_URL=
VEYRA_SUPPORT_URL=
VEYRA_ACCOUNT_DELETION_URL=

# Firebase Authentication (web public config; safe to expose to browser)
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration
# Alternative: set FIREBASE_WEB_CONFIG_JSON to the Firebase Web App config JSON.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_GOOGLE_ENABLED=true
# Set true only after Apple Developer Services ID/domain/return URL and Firebase Apple provider are configured.
FIREBASE_APPLE_ENABLED=false
# Server-side Firebase Admin credentials. Never expose this value to clients.
FIREBASE_SERVICE_ACCOUNT_JSON=

# PayTR Web Card Checkout (server only)
# PayTR Merchant Panel > Destek & Kurulum > Entegrasyon Bilgileri
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Start with 1 while testing, change to 0 for live payments.
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
# Web card prices in TRY. Checkout remains disabled if a value is 0/empty.
VEYRA_WEB_PRICE_100_TRY=
VEYRA_WEB_PRICE_500_TRY=
VEYRA_WEB_PRICE_1500_TRY=
# Configure PayTR Bildirim URL as:
# https://veyra-ai-sigma.vercel.app/api/paytr/callback

# Android / Google Play Billing
GOOGLE_PLAY_PACKAGE=ai.veyra.app
# Full service-account JSON with Android Publisher API permission. Server only.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_REQUIRED=false

# Apple / App Store Server API
APPLE_BUNDLE_ID=ai.veyra.app
# Numeric App Store Connect Apple ID for the app (required for production JWS verification).
APPLE_APP_ID=
# Users and Access > Integrations > In-App Purchase
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Contents of the .p8 In-App Purchase private key; server only.
APPLE_IAP_PRIVATE_KEY=
# Comma-separated base64 DER Apple Root CA certificates used by SignedDataVerifier.
APPLE_ROOT_CA_B64=

# AI providers
AI_PROVIDER_PRIMARY=runway
AI_PROVIDER_FALLBACK=mock
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
HF_TOKEN=
HF_INFERENCE_PROVIDER=auto
REPLICATE_API_TOKEN=

# Storage / analytics placeholders
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SENTRY_DSN=
