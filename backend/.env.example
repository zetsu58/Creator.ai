PORT=8080
NODE_ENV=development
VEYRA_ADMIN_TOKEN=change-me
VEYRA_SESSION_SECRET=change-me-to-a-random-32-plus-character-secret
DATABASE_URL=
REDIS_URL=
VEYRA_PUBLIC_BASE_URL=https://veyra-ai-sigma.vercel.app

# Public legal/support URLs
VEYRA_PRIVACY_URL=
VEYRA_TERMS_URL=
VEYRA_SUPPORT_URL=
VEYRA_ACCOUNT_DELETION_URL=

# Firebase Authentication
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_APPLE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
VEYRA_WEB_PRICE_100_TRY=
VEYRA_WEB_PRICE_500_TRY=
VEYRA_WEB_PRICE_1500_TRY=

# Android / Google Play Billing
GOOGLE_PLAY_PACKAGE=ai.veyra.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
PLAY_INTEGRITY_REQUIRED=false

# Apple / App Store Server API
APPLE_BUNDLE_ID=ai.veyra.app
APPLE_APP_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_ROOT_CA_B64=

# AI providers
# Free/credit-first option: create a Pollinations key and set primary=pollinations.
# Pollinations currently exposes Wan/Seedance/Veo-family video models; availability/credits are provider-controlled.
AI_PROVIDER_PRIMARY=pollinations
AI_PROVIDER_FALLBACK=runway
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan
# Optional Hugging Face free monthly inference credits.
HF_TOKEN=
HF_INFERENCE_PROVIDER=auto
HF_VIDEO_MODEL=Lightricks/LTX-Video-0.9.8-13B-distilled
# Optional private GPU worker for later scale-up.
VEYRA_GPU_BASE_URL=
VEYRA_GPU_API_SECRET=
# Paid fallback.
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
# Optional paid provider.
REPLICATE_API_TOKEN=

# Storage / analytics placeholders
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SENTRY_DSN=
